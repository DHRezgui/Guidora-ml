# ML Environment Configuration
# ============================
# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trustdev_onboarding
DB_USER=postgres
DB_PASSWORD=postgres

# Model Configuration
MODEL_VERSION=1.0.0
MODEL_TYPE=lightgbm

# Training Configuration
RANDOM_STATE=42
TEST_SIZE=0.2
VALIDATION_SIZE=0.1

# Feature Configuration
SCALE_FEATURES=true
HANDLE_MISSING=true
REMOVE_OUTLIERS=false

# Logging
LOG_LEVEL=INFO
